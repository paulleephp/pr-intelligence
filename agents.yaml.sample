github_app:
  app_id: ${GITHUB_APP_ID}
  installation_id: ${GITHUB_INSTALLATION_ID}
  private_key_path: ~/.config/kitchen-agents/private-key.pem

repo:
  main_path: ~/repos/pr-intelligence
  worktrees_dir: ~/repos/pr-intelligence

agents:
  - id: mochi
    cmux_session: mochi
    worktree: main
    role: orchestrator_intake
    description: Pulls tasks, plans work, and dispatches prompts to worker sessions

  - id: boba
    cmux_session: boba
    worktree: boba
    role: backend_engineer
    description: Builds APIs, database queries, and server-side business logic

  - id: takoyaki
    cmux_session: takoyaki
    worktree: takoyaki
    role: frontend_engineer
    description: Builds UI components, state handling, and client-side interactions

  - id: kimchi
    cmux_session: kimchi
    worktree: kimchi
    role: tester
    description: Writes and runs unit, integration, and end-to-end tests

  - id: banh-mi
    cmux_session: banh-mi
    worktree: banh-mi
    role: reviewer
    description: Audits diffs, enforces code quality, and posts PR reviews
